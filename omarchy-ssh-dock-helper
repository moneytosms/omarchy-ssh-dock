#!/usr/bin/env bash
# omarchy-ssh-dock-helper: inventory + session scan for SSH Dock.
# Emits one JSON object on stdout:
#   { "state": "ok",
#     "servers":  [ { "alias": "web01", "host": "…", "user": "…", "port": 22 } ],
#     "sessions": [ "web01", … ] }
# With `alerts <since-ms>`: emits one JSON array of desktop-notification
# toasts (JSON files in $OMARCHY_NOTIFICATIONS_DIR, default
# ~/.local/state/omarchy/notifications/) modified after since-ms,
# newest last:
#   [ { "app": "herdr", "summary": "…", "body": "…", "ts": 123456789 }, … ]
set -euo pipefail

# Alert scan mode: omarchy-ssh-dock-helper alerts <since-ms>.
if [[ "${1:-}" == "alerts" ]]; then
  since_ms="${2:-0}"
  notifs_dir="${OMARCHY_NOTIFICATIONS_DIR:-$HOME/.local/state/omarchy/notifications}"

  alerts_tmp="/tmp/.omarchy-ssh-dock-alerts.$$"
  : > "$alerts_tmp"
  if [[ -d "$notifs_dir" ]] && command -v jq >/dev/null; then
    {
      # mtime (sec.nsec) + path per live toast file.
      find "$notifs_dir" -maxdepth 1 -type f -printf '%T@\t%p\n' 2>/dev/null || true
    } |
      # Keep entries newer than since-ms (epoch ms); emit "path\tts".
      awk -F'\t' -v since="$since_ms" '
        NF == 2 { ts = int($1 * 1000); if (ts > since + 0) print $2 "\t" ts }
      ' |
      # One jq per file: unparseable files error out and are skipped.
      while IFS=$'\t' read -r f ts; do
        jq -c --argjson ts "$ts" '
          { app:     ((.app_name // "") | tostring),
            summary: ((.summary   // "") | tostring),
            body:    ((.body      // "") | tostring),
            ts:      $ts }
        ' "$f" >> "$alerts_tmp" 2>/dev/null || true
      done || true
  fi
  jq -Rsc '
    split("\n")
    | map(select(length > 0))
    | map(fromjson)
    | sort_by(.ts)
  ' "$alerts_tmp"
  rm -f "$alerts_tmp"
  exit 0
fi

ssh_config="${SSH_CONFIG:-$HOME/.ssh/config}"

servers_json="[]"
if [[ -f "$ssh_config" ]] && command -v jq >/dev/null; then
  # Top-level Host entries. Skip wildcard/negated patterns. Track
  # HostName/User/Port per entry (indented or same-file style).
  servers_json="$(awk '
    {
      raw = $0
      indent = (raw ~ /^[[:space:]]/)
      gsub(/^[[:space:]]+/, "", raw); gsub(/[[:space:]]+$/, "", raw)
      if (raw == "") { next }
      n = split(raw, tok, /[[:space:]]+/)
      key = tolower(tok[1])
      val = ""
      if (n > 1) { val = tok[2] }
      if (!indent && key == "host") {
        if (alias != "") print alias "\t" host "\t" user "\t" port
        alias = val; host = ""; user = ""; port = ""
        if (alias == "" || alias ~ /[*!]/) { alias = "" }
      } else if (alias != "" && n > 1) {
        if (key == "hostname") { host = val }
        else if (key == "user") { user = val }
        else if (key == "port") { port = val }
      }
    }
    END { if (alias != "") print alias "\t" host "\t" user "\t" port }
  ' "$ssh_config" | jq -Rsc '
    split("\n")
    | map(select(length > 0))
    | map(split("\t"))
    | map({
        alias: .[0],
        host:  (.[1] // "" | if . == "" then null else . end),
        user:  (.[2] // "" | if . == "" then null else . end),
        port:  (.[3] // "" | if . == "" then null else (tonumber? // 22) end)
      })
    | map(.host //= .alias)
    | map(.port //= 22)
  ')"
fi

sessions_json="[]"
if command -v jq >/dev/null; then
  {
    # ControlMaster sockets: ~/.ssh/sockets/<name>--<port>:<port> style names.
    if [[ -d "$HOME/.ssh/sockets" ]]; then
      find "$HOME/.ssh/sockets" -maxdepth 1 -type s -printf '%f\n' 2>/dev/null |
        sed -E 's/--[0-9]+:[0-9]+$//'
    fi
    # Live ssh processes: extract user@host / host tokens, skip tunnels/scp.
    pgrep -a ssh 2>/dev/null | sed -E 's/^[0-9]+ //' |
      grep -vE '(^| )(scp|sftp|sshfs)( |$)| -(W|L|D|R|N)[[:space:]=]' || true |
      tr ' ' '\n' | grep -E '^([^@[:space:]]+@)?[^[:space:]@-][^[:space:]]*$' || true |
      sed -E 's/^.*@//' | grep -vE '^(ssh|-)' || true
  } | sort -u > /tmp/.omarchy-ssh-dock-sessions.$$ || true
  sessions_json="$(jq -Rsc 'split("\n") | map(select(length > 0))' /tmp/.omarchy-ssh-dock-sessions.$$)"
  rm -f /tmp/.omarchy-ssh-dock-sessions.$$
fi

jq -n --argjson s "$servers_json" --argjson c "$sessions_json" \
  '{state: "ok", servers: $s, sessions: $c}'
