#!/usr/bin/env bash
# omarchy-ssh-dock-pick: standalone fuzzy picker for SSH Dock servers.
# Lists ~/.ssh/config hosts via the native omarchy menu, then connects
# through the widget's IPC (so mode/dryRun/alerts stay in sync with the panel).
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
helper="$plugin_dir/omarchy-ssh-dock-helper"

rows=()
while IFS=$'\t' read -r alias sub; do
  [[ -z "$alias" ]] && continue
  rows+=("$alias" "$sub")
done < <("$helper" | jq -r '.servers[] | [.alias, ((.user // "" | if . == "" then "" else . + "@" end) + (.host // .alias) + ":" + ((.port // 22)|tostring))] | @tsv')

if (( ${#rows[@]} == 0 )); then
  notify-send "SSH Dock" "No servers found in ~/.ssh/config" 2>/dev/null || echo "SSH Dock: no servers found in ~/.ssh/config" >&2
  exit 1
fi

# omarchy-menu-select takes flat label/subtext pairs as separate options args;
# build "<label>\t<subtext>" per option so selection returns the alias first.
options=()
for ((i = 0; i < ${#rows[@]}; i += 2)); do
  options+=("${rows[i]}"$'\t'"${rows[i+1]}")
done

selection="$(omarchy-menu-select "SSH" "${options[@]}" -- --width 480)" || exit 0
alias="${selection%%$'\t'*}"
[[ -z "$alias" ]] && exit 0

omarchy-shell io.github.moneytosms.ssh-dock connect "$alias"
